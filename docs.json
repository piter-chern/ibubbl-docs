{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "iBubbl",
  "colors": {
    "primary": "#3B82F6",
    "light": "#60A5FA",
    "dark": "#2563EB"
  },
  "fonts": {
    "heading": {
      "family": "Geist",
      "weight": 600
    },
    "body": {
      "family": "Geist"
    }
  },
  "favicon": "/favicon.ico",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://ibubbl-dashboard.vercel.app"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Sign up",
      "href": "https://ibubbl-dashboard.vercel.app/signup"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "mcp", "cursor", "vscode"]
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "introduction",
          "quickstart",
          "authentication",
          "build-with-ai"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "concepts/message-lifecycle",
          "concepts/limits",
          "concepts/lines-and-routing",
          "idempotency",
          "concepts/pagination",
          "concepts/working-hours",
          "concepts/after-hours-reply",
          "concepts/suppression",
          "concepts/group-conversations"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/send-messages",
          "guides/schedule-messages",
          "guides/attachments",
          "guides/reactions-read-receipts-typing",
          "guides/editing-and-unsending",
          "guides/receive-messages",
          "guides/webhook-signatures",
          "guides/test-webhooks-locally",
          "guides/webhook-retries",
          "inbound-events/overview"
        ]
      },
      {
        "group": "Webhooks",
        "pages": [
          "webhooks/overview",
          "webhooks/events"
        ]
      },
      {
        "group": "API reference",
        "pages": [
          {
            "group": "Messages",
            "pages": [
              "api-reference/messages/send",
              "api-reference/messages/list",
              "api-reference/messages/retrieve",
              "api-reference/messages/edit",
              "api-reference/messages/unsend",
              "api-reference/messages/cancel",
              "api-reference/messages/react",
              "api-reference/messages/remove-reaction"
            ]
          },
          {
            "group": "Scheduled messages",
            "pages": [
              "api-reference/scheduled-messages/create",
              "api-reference/scheduled-messages/list",
              "api-reference/scheduled-messages/retrieve",
              "api-reference/scheduled-messages/update",
              "api-reference/scheduled-messages/cancel"
            ]
          },
          {
            "group": "Files",
            "pages": [
              "api-reference/files/upload",
              "api-reference/files/retrieve",
              "api-reference/files/delete"
            ]
          },
          {
            "group": "Contacts",
            "pages": [
              "api-reference/contacts/upsert",
              "api-reference/contacts/list",
              "api-reference/contacts/retrieve",
              "api-reference/contacts/update",
              "api-reference/contacts/delete",
              "api-reference/contacts/add-tag",
              "api-reference/contacts/remove-tag",
              "api-reference/contacts/opt-out",
              "api-reference/contacts/block",
              "api-reference/contacts/unblock"
            ]
          },
          {
            "group": "Conversations",
            "pages": [
              "api-reference/conversations/mark-read",
              "api-reference/conversations/start-typing",
              "api-reference/conversations/stop-typing"
            ]
          },
          {
            "group": "Lines",
            "pages": [
              "api-reference/lines/list",
              "api-reference/lines/retrieve"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "api-reference/webhooks/create",
              "api-reference/webhooks/list",
              "api-reference/webhooks/retrieve",
              "api-reference/webhooks/revoke"
            ]
          },
          {
            "group": "Inbound events",
            "pages": [
              "api-reference/inbound-events/receive"
            ]
          }
        ]
      },
      {
        "group": "Resources",
        "pages": [
          "errors",
          "openapi",
          "versioning",
          "changelog",
          "support"
        ]
      }
    ]
  },
  "api": {
    "openapi": "openapi/public.json",
    "playground": {
      "display": "simple"
    },
    "examples": {
      "languages": ["curl", "typescript", "python"]
    }
  },
  "redirects": [
    {
      "source": "/webhooks/signatures",
      "destination": "/guides/webhook-signatures"
    }
  ]
}
