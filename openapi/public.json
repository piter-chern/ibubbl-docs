      "MessageCreate": {
        "properties": {
          "contact_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contact Id",
            "description": "1:1 send by existing contact ID. Mutually exclusive with `to`, `chat_guid`, and `participant_phones`.",
            "examples": [
              "c8a1f4e2-3b9d-4f7c-a8e5-1d2c3b4a5e6f"
            ]
          },
          "to": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\+[1-9]\\d{7,14}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "To",
            "description": "1:1 send by E.164 phone number (e.g. `+14155551234`). If the number doesn't match an existing contact, one is created automatically. Mutually exclusive with `contact_id`, `chat_guid`, and `participant_phones`.",
            "examples": [
              "+14155551234"
            ]
          },
          "chat_guid": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chat Guid",
            "description": "Send into an existing iMessage group identified by its BlueBubbles-issued `chat_guid` (`any;+;<hex>`). Get this value from a prior `message.inbound` webhook event or `GET /v1/messages/{id}` response. Mutually exclusive with `contact_id`, `to`, and `participant_phones`.",
            "examples": [
              "any;+;067ace6caf6c43aaa2f7d643975e15ea"
            ]
          },
          "participant_phones": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Participant Phones",
            "description": "Create a brand-new iMessage group and send the first message in one call. List of 2 or more E.164 phone numbers (your iBubbl line is added automatically; do not include it). Mutually exclusive with `contact_id`, `to`, and `chat_guid`. Optionally pair with `group_name` to set the group's display name.",
            "examples": [
              [
                "+14155551234",
                "+14155557654"
              ]
            ]
          },
          "group_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Group Name",
            "description": "Display name for a new iMessage group. Only valid alongside `participant_phones`. Optional \u2014 iMessage will fall back to the participants' names if omitted.",
            "examples": [
              "Team Alpha"
            ]
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "title": "Body",
            "description": "The message text. Plain text only; emoji + Unicode are supported.",
            "examples": [
              "Hey Sam \u2014 quick check-in about your order."
            ]
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Idempotency Key",
            "description": "Client-supplied unique key per logical send. Retrying with the same key + same payload replays the cached response (24-hour TTL). Same key + different payload returns `409 idempotency_conflict`. UUIDv4 is recommended.",
            "examples": [
              "a3f2c8d9-e0f1-4b4d-9c5a-7b8e2d1f0c4a"
            ]
          }
        },
        "type": "object",
        "required": [
          "body",
          "idempotency_key"
        ],
        "title": "MessageCreate",
        "example": {
          "body": "Hey Sam \u2014 quick check-in about your order.",
          "idempotency_key": "a3f2c8d9-e0f1-4b4d-9c5a-7b8e2d1f0c4a",
          "to": "+14155551234"
        }
      },
