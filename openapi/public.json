{
  "openapi": "3.1.0",
  "info": {
    "title": "iBubbl API",
    "version": "v1",
    "description": "The iBubbl REST API. Send iMessages, manage contacts, and subscribe to webhook events from your backend.\n\nAuthenticate every request with a Bearer API key (`ib_pk_<hex>`) \u2014 generate one from your dashboard's API Access settings. See the [Authentication](/authentication) guide."
  },
  "paths": {
    "/v1/messages": {
      "post": {
        "tags": [
          "Messages"
        ],
        "summary": "Send a message",
        "description": "Send an iMessage to a contact, identified by either `contact_id` (an existing contact in your account) or `to` (an E.164 phone number \u2014 the contact is created on first use).\n\nThe response returns immediately with `status: \"queued\"` or `\"pending\"`. Final delivery state arrives via the [`message.delivered`](/webhooks/events) webhook.\n\n**Idempotency is required.** Provide a unique `idempotency_key` per logical send (UUIDv4 recommended); a retry with the same key and payload replays the original response, while a reused key with a different payload returns `409 idempotency_conflict`. See the [Idempotency](/idempotency) guide.\n\nSuppression is enforced server-side: messaging an opted-out contact returns `422 contact_opted_out`.",
        "operationId": "v1_send_message_v1_messages_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageCreate"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Message accepted for delivery.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Contact not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency key reused with a different payload.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Validation failure \u2014 missing required field, opted-out contact, or capacity exhausted. See `detail.error`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "No active line available to send from.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/messages/{message_id}": {
      "get": {
        "tags": [
          "Messages"
        ],
        "summary": "Retrieve a message",
        "description": "Fetch a single message by its ID. Useful for polling the current delivery state when you can't subscribe to webhooks.\n\nReturns `404 not_found` for both missing messages and messages owned by a different customer \u2014 existence is not leaked across tenants.",
        "operationId": "v1_get_message_v1_messages__message_id__get",
        "parameters": [
          {
            "name": "message_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Message Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Message not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/contacts": {
      "post": {
        "tags": [
          "Contacts"
        ],
        "summary": "Create or update a contact",
        "description": "Upsert a contact by phone number. Returns `201 Created` on a new contact, `200 OK` on an existing match.\n\nOptional fields (`first_name`, `last_name`, `timezone`) apply only when the existing record's value is null \u2014 values set previously by a rep or by a prior API call are preserved. This protects human-edited data from being clobbered by automation.\n\nIf `timezone` is provided, it must be one of the supported IANA timezones; invalid values return `422 invalid_timezone`.",
        "operationId": "v1_upsert_contact_v1_contacts_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactUpsert"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing contact updated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Contact"
                }
              }
            }
          },
          "201": {
            "description": "New contact created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Contact"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Validation failure \u2014 `phone` not in E.164 format, or `timezone` not in the supported allowlist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/contacts/{contact_id}": {
      "get": {
        "tags": [
          "Contacts"
        ],
        "summary": "Retrieve a contact",
        "description": "Fetch a single contact by ID. Returns `404 not_found` for both missing contacts and contacts owned by a different customer \u2014 existence is not leaked across tenants.",
        "operationId": "v1_get_contact_v1_contacts__contact_id__get",
        "parameters": [
          {
            "name": "contact_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Contact Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The contact.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Contact"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Contact not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/webhooks": {
      "post": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Create a webhook subscription",
        "description": "Register an HTTPS endpoint to receive events. The response includes the signing secret **once** \u2014 store it immediately; it cannot be retrieved again. Use the secret to verify incoming webhook signatures (see [Signature Verification](/webhooks/signatures)).\n\nIf `event_types` is omitted, the subscription receives all event types. You can register multiple subscriptions per account (e.g., one for production, one for staging).\n\nDelivery is at-least-once with exponential backoff. Customer endpoints should be idempotent based on the event `id`.",
        "operationId": "v1_create_webhook_v1_webhooks_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookSubscriptionCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Subscription created. Secret returned ONCE.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookSubscriptionCreated"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "URL is not HTTPS.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Webhooks"
        ],
        "summary": "List webhook subscriptions",
        "description": "Returns all currently active webhook subscriptions for the authenticated customer. Revoked subscriptions are omitted \u2014 query them by ID directly (`GET /v1/webhooks/{id}`) if you need their history.",
        "operationId": "v1_list_webhooks_v1_webhooks_get",
        "responses": {
          "200": {
            "description": "Array of active subscriptions.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WebhookSubscription"
                  },
                  "title": "Response V1 List Webhooks V1 Webhooks Get"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/webhooks/{subscription_id}": {
      "get": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Retrieve a webhook subscription",
        "description": "Fetch a single subscription by ID. Returns the subscription regardless of revoked status (so you can inspect history). `404 not_found` is returned for both missing subscriptions and those owned by a different customer.",
        "operationId": "v1_get_webhook_v1_webhooks__subscription_id__get",
        "parameters": [
          {
            "name": "subscription_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Subscription Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The subscription.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookSubscription"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Subscription not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Revoke a webhook subscription",
        "description": "Soft-revoke a subscription. After revocation, no further events are delivered to its URL. The row is retained for audit purposes; you can still fetch it with `GET /v1/webhooks/{id}` and see its `revoked_at` timestamp.\n\nRevoking an already-revoked subscription is a no-op that returns `{\"status\": \"already_revoked\"}`.",
        "operationId": "v1_revoke_webhook_v1_webhooks__subscription_id__delete",
        "parameters": [
          {
            "name": "subscription_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Subscription Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Revocation result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookRevokeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Subscription not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events/{token}": {
      "post": {
        "tags": [
          "Inbound Events"
        ],
        "summary": "Receive an event from a connected app",
        "description": "Receive a webhook from a connected third-party app (for example Recharge) and start any workflow whose **Webhook received** trigger matches it.\n\nThe URL you paste into the sending app carries its own credential, so this endpoint takes no `Authorization` header. Create a source in **Settings \u2192 Inbound events** to get the full URL; the token is shown once.\n\nEvery request must be signed. For Recharge, that is the `X-Recharge-Hmac-Sha256` header computed with your **API Client Secret** \u2014 which is not the same value as your API token. An unsigned or mis-signed request returns `403 invalid_signature`.\n\n**Redeliveries are safe.** Providers resend events, and Recharge's dunning fires one event per charge retry. Each workflow's `event_id_path` identifies the underlying object, so repeat deliveries of the same event fold onto the run that already exists rather than messaging the customer again.\n\nA `200` means the event was accepted, not that it matched anything \u2014 check `runs_started`, and see the source's status in Settings when it is unexpectedly `0`.",
        "operationId": "receive_event_v1_events__token__post",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Event accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventAck"
                }
              }
            }
          },
          "403": {
            "description": "Signature missing or does not match.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "No such source, or it has been revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413": {
            "description": "Body larger than 256 KB.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "properties": {
          "detail": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ApiErrorDetail"
              }
            ],
            "description": "Error envelope. The outer `detail` key is FastAPI's convention for error responses; the inner `error` + `message` are the iBubbl API's stable shape."
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ApiError",
        "example": {
          "detail": {
            "error": "validation_error",
            "message": "Either 'contact_id' or 'to' (E.164 phone) is required"
          }
        }
      },
      "ApiErrorDetail": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error",
            "description": "Stable machine-readable error code. Use this for branching logic in your integration; the human-readable `message` is subject to change. See the Error Reference for the catalog.",
            "examples": [
              "validation_error"
            ]
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Human-readable description of what went wrong.",
            "examples": [
              "Either 'contact_id' or 'to' (E.164 phone) is required"
            ]
          }
        },
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "title": "ApiErrorDetail"
      },
      "Contact": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Unique contact identifier (UUID)."
          },
          "phone": {
            "type": "string",
            "title": "Phone",
            "description": "Contact's phone number (E.164)."
          },
          "first_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Name"
          },
          "last_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Name"
          },
          "timezone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timezone",
            "description": "IANA timezone, or null if not set. When null, sends use the customer's default working-hours timezone."
          },
          "opted_out": {
            "type": "boolean",
            "title": "Opted Out",
            "description": "True if this contact has opted out (STOP reply or manual opt-out). When true, all send attempts to this contact return `422 contact_opted_out`."
          },
          "opted_out_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Opted Out At",
            "description": "ISO 8601 UTC timestamp of the opt-out, or null."
          },
          "created_at": {
            "type": "string",
            "title": "Created At",
            "description": "ISO 8601 UTC timestamp the contact was created."
          }
        },
        "type": "object",
        "required": [
          "id",
          "phone",
          "opted_out",
          "created_at"
        ],
        "title": "Contact",
        "example": {
          "created_at": "2026-05-17T14:23:45.123Z",
          "first_name": "Sam",
          "id": "c8a1f4e2-3b9d-4f7c-a8e5-1d2c3b4a5e6f",
          "last_name": "Rivera",
          "opted_out": false,
          "phone": "+14155551234",
          "timezone": "America/Los_Angeles"
        }
      },
      "EventAck": {
        "properties": {
          "received": {
            "type": "boolean",
            "title": "Received",
            "description": "Always `true` once the signature has been verified.",
            "examples": [
              true
            ]
          },
          "runs_started": {
            "type": "integer",
            "title": "Runs Started",
            "description": "How many workflow runs this event started. `0` is a normal answer \u2014 it means no active workflow's trigger matched, or this event was a redelivery that de-duplicated onto an existing run.",
            "examples": [
              1
            ]
          }
        },
        "type": "object",
        "required": [
          "received",
          "runs_started"
        ],
        "title": "EventAck",
        "example": {
          "received": true,
          "runs_started": 1
        }
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Message": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Unique message identifier (UUID)."
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "pending",
              "sent",
              "delivered",
              "read",
              "failed"
            ],
            "title": "Status",
            "description": "Lifecycle state. `queued` = accepted, not yet dispatched (capacity / working-hours hold). `pending` = handed to the device, waiting on the send. `sent` / `delivered` / `read` = delivery progression. `failed` = terminal failure \u2014 see webhook `message.failed` for the reason."
          },
          "to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "To",
            "description": "Destination phone number (E.164) for 1:1 sends. Null for group sends \u2014 group destination is identified by `chat_guid` instead.",
            "examples": [
              "+14155551234"
            ]
          },
          "body": {
            "type": "string",
            "title": "Body",
            "description": "The message text as sent."
          },
          "contact_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contact Id",
            "description": "ID of the contact this message was sent to. For groups, this is the 'primary' participant the message was addressed to (the first participant in `participant_phones` on a new group create); the conversation's full participant list is available via the conversation."
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id",
            "description": "ID of the conversation this message belongs to. Stable for the lifetime of the conversation; use it to fetch the thread or correlate webhook events."
          },
          "conversation_kind": {
            "type": "string",
            "enum": [
              "one_to_one",
              "group"
            ],
            "title": "Conversation Kind",
            "description": "`one_to_one` for sends to a single contact, `group` for iMessage groups (2+ participants in addition to your iBubbl line).",
            "default": "one_to_one"
          },
          "chat_guid": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chat Guid",
            "description": "BlueBubbles-issued opaque identifier for the group chat (`any;+;<hex>`). Returned for `group` sends \u2014 use it to address subsequent messages to the same group via the `chat_guid` request shape. Null for `one_to_one` sends and for brand-new group creates that haven't yet been finalized by the device (the value populates within ~5\u201310s once the device creates the iMessage chat; poll `GET /v1/messages/{id}` to observe the transition).",
            "examples": [
              "any;+;067ace6caf6c43aaa2f7d643975e15ea"
            ]
          },
          "channel": {
            "type": "string",
            "enum": [
              "imessage",
              "sms"
            ],
            "title": "Channel",
            "description": "Transport used. `imessage` for blue-bubble delivery (default). `sms` is reserved for future SMS fallback routing."
          },
          "sent_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sent At",
            "description": "ISO 8601 UTC timestamp when the message left the device. Null until the device confirms send.",
            "examples": [
