      "ContactUpsert": {
        "properties": {
          "phone": {
            "type": "string",
            "title": "Phone",
            "description": "Phone number in E.164 format (e.g. `+14155551234`). The unique key for contacts \u2014 upserting an existing phone returns the same contact ID.",
            "examples": [
              "+14155551234"
            ]
          },
          "first_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "First Name",
            "description": "Contact's first name. Only applied if the existing record's `first_name` is null \u2014 rep-edited values are sticky and won't be overwritten by automation.",
            "examples": [
              "Sam"
            ]
          },
          "last_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Name",
            "description": "Contact's last name. Same sticky-update semantics as `first_name`.",
            "examples": [
              "Rivera"
            ]
          },
          "timezone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timezone",
            "description": "IANA timezone for working-hours scheduling. Must be one of the supported allowlist (US/Canada timezones, plus common international). Sends to this contact respect the timezone for outside-hours scheduling. Same sticky-update semantics as names.",
            "examples": [
              "America/Los_Angeles"
            ]
          }
        },
        "type": "object",
        "required": [
          "phone"
        ],
        "title": "ContactUpsert",
        "example": {
